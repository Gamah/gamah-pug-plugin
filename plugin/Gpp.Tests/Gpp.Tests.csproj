<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Gpp.Tests</RootNamespace>
  </PropertyGroup>

  <!--
    The plugin itself cannot be referenced: it inherits from CounterStrikeSharp's BasePlugin, which needs
    the engine to do anything at all. So the two files with no engine in them are compiled straight into
    the test assembly instead. Keeping them engine-free is what makes any of this testable - see
    MatchRules.cs.
  -->
  <ItemGroup>
    <Compile Include="../Gpp/MatchRules.cs" />
    <Compile Include="../Gpp/StatsStore.cs" />
    <Compile Include="../Gpp/HudLayout.cs" />
    <Compile Include="../Gpp/HudMetrics.cs" />
    <Compile Include="../Gpp/WorldLayout.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
